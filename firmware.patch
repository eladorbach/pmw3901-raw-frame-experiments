+/* PMW3901 bench camera mode based on Bitcraze's publicly released framebuffer
+ * register sequence. Every busy wait has a monotonic deadline.
+ * Mode transition is one-way: power cycle to resume optical-flow tracking.
+ */
+static bool benchFrameMode = false;
+volatile uint32_t pmwBenchPolls = 0;
+volatile uint32_t pmwBenchCaptureUs = 0;
+volatile uint16_t pmwBenchQuarterMs[4] = {0};
+static bool benchWaitReady(const deckPin_t csPin, const uint64_t deadline)
+{
+  unsigned polls = 0;
+  while (usecTimestamp() < deadline) {
+    if ((registerRead(csPin, 0x58) >> 6) != 3) return true;
+    if (++polls % 8u == 0u) { watchdogReset(); vTaskDelay(1); }
+  }
+  return false;
+}
+
+bool pmw3901CaptureBenchFrame(const deckPin_t csPin, uint8_t pixels[1225])
+{
+
+  if (!isInit || pixels == NULL) return false;
+  const uint64_t captureStart = usecTimestamp();
+  pmwBenchPolls = 0;
+  const uint64_t deadline = captureStart + 30000000ULL;
+  if (!benchFrameMode) {
+    registerWrite(csPin, 0x7F, 0x07);
+    registerWrite(csPin, 0x41, 0x1D);
+    registerWrite(csPin, 0x4C, 0x00);
+    registerWrite(csPin, 0x7F, 0x08);
+    registerWrite(csPin, 0x6A, 0x38);
+    registerWrite(csPin, 0x7F, 0x00);
+    registerWrite(csPin, 0x55, 0x04);
+    registerWrite(csPin, 0x40, 0x80);
+    registerWrite(csPin, 0x4D, 0x11);
+    registerWrite(csPin, 0x70, 0x00);
+    registerWrite(csPin, 0x58, 0xFF);
+    benchFrameMode = true; /* frame mode remains enabled after a failed capture */
+    if (!benchWaitReady(csPin, deadline)) { pixels[0]=0xFE; pixels[1]=0; return false; }
+    sleepus(50);
+  }
+
+  for (unsigned i=0; i<1225; i++) {
+    uint8_t a = 0;
+    bool found = false;
+    unsigned polls = 0;
+    const uint64_t pixelDeadline = usecTimestamp() + 250000ULL;
+    while (usecTimestamp() < deadline && usecTimestamp() < pixelDeadline) {
+      a = benchRegisterReadFast(csPin, 0x58);
+      pmwBenchPolls++;
+      if ((a >> 6) == 1) {found=true;break;}
+      // Do not starve the USB/CRTP and system tasks when a pixel is unavailable.
+      if (++polls % 8u == 0u) { watchdogReset(); vTaskDelay(1); }
+    }
+    if (!found) { pixels[0]=(uint8_t)(i>>8); pixels[1]=(uint8_t)i; return false; }
+    watchdogReset();
+    if ((i & 15u) == 15u) vTaskDelay(1);
+    const uint8_t b = benchRegisterReadFast(csPin, 0x58);
+    pixels[i] = (uint8_t)((a << 2) | (b & 0x0C));
+    if (i == 305u || i == 611u || i == 917u || i == 1224u) {
+      const unsigned q = i == 305u ? 0u : i == 611u ? 1u : i == 917u ? 2u : 3u;
+      pmwBenchQuarterMs[q] = (uint16_t)((usecTimestamp() - captureStart) / 1000u);
+    }
+  }
+  watchdogReset();
+  registerWrite(csPin, 0x70, 0x00);
+  registerWrite(csPin, 0x58, 0xFF);
+  if (!benchWaitReady(csPin, deadline)) { pixels[0]=0xFD; pixels[1]=0; return false; }
+  pmwBenchCaptureUs = (uint32_t)(usecTimestamp() - captureStart);
+  return true;
+}
