+// Polling SPI transfer for single-byte register access.
+ // Must be called while holding spiBeginTransaction() mutex.
+bool spiExchangeBytePolling(uint8_t tx, uint8_t *rx)
+{
+  uint32_t limit = 100000u;
+  SPI_Cmd(SPI, ENABLE);
+  while (SPI_I2S_GetFlagStatus(SPI, SPI_I2S_FLAG_TXE) == RESET && --limit) {}
+  if (!limit) { SPI_Cmd(SPI, DISABLE); return false; }
+  SPI_I2S_SendData(SPI, tx);
+  limit = 100000u;
+  while (SPI_I2S_GetFlagStatus(SPI, SPI_I2S_FLAG_RXNE) == RESET && --limit) {}
+  if (!limit) { SPI_Cmd(SPI, DISABLE); return false; }
+  *rx = (uint8_t)SPI_I2S_ReceiveData(SPI);
+  limit = 100000u;
+  while (SPI_I2S_GetFlagStatus(SPI, SPI_I2S_FLAG_BSY) != RESET && --limit) {}
+  SPI_Cmd(SPI, DISABLE);
+  return limit != 0u;
+}
