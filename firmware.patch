+/* Bench image stream through existing app channel (CRTP port 13 channel 2).
+ * PXV -> PX! version 1, PX? -> 49 segments followed by CRC32 trailer.
+ * Never install on a flight-ready Crazyflie; remove propellers.
+ */
+static uint8_t benchCameraMode = 0;
+static uint8_t benchFrameId = 0;
+static uint8_t benchPixels[1225];
+extern volatile uint32_t pmwBenchPolls;
+extern volatile uint32_t pmwBenchCaptureUs;
+extern volatile uint16_t pmwBenchQuarterMs[4];
+
+static uint32_t benchCrc32(const uint8_t *bytes, size_t size)
+{
+  uint32_t crc=0xFFFFFFFFu;
+  for (size_t i=0;i<size;i++) {
+    crc ^= bytes[i];
+    for (unsigned bit=0;bit<8;bit++)
+      crc=(crc>>1)^((crc&1u)?0xEDB88320u:0u);
+  }
+  return crc ^ 0xFFFFFFFFu;
+}
+
+static bool benchSend(const uint8_t *buf, size_t size)
+{
+  for (unsigned attempt=0; attempt<40;attempt++) {
+    watchdogReset();
+    if (appchannelSendDataPacket((void *)buf,size)==pdTRUE) {
+      // Throttle CRTP so the USB link and queue can drain between fragments.
+      vTaskDelay(2);
+      return true;
+    }
+    vTaskDelay(2);
+  }
+  return false;
+}
+
+static void benchSendImage(void)
+{
+  watchdogReset();
+  const uint8_t frameId=++benchFrameId;
+  // Isolate one real PMW3901 register access from full frame acquisition.
+  const bool ok=pmw3901CaptureBenchFrame(NCS_PIN,benchPixels);
+  uint8_t data[30]={ 'P','X',frameId,0,49 };
+  if (ok) {
+    for (uint8_t i=0;i<49;i++) {
+      data[3]=i;
+      memcpy(data+5,benchPixels+25u*i,25u);
+      if (!benchSend(data,sizeof(data))) return;
+    }
+  }
+  data[3]=255;
+  data[4]=ok?0:1;
+  // On capture failure, report the failing pixel index (big-endian).
+  if (!ok) { data[5]=benchPixels[0]; data[6]=benchPixels[1]; }
+  const uint32_t crc=ok?benchCrc32(benchPixels,sizeof(benchPixels)):0;
+  if (ok) {
+    data[5]=(uint8_t)crc;
+    data[6]=(uint8_t)(crc>>8);
+    data[7]=(uint8_t)(crc>>16);
+    data[8]=(uint8_t)(crc>>24);
+  }
+  // Trailer bytes 9..16: acquisition microseconds and pixel-ready polls.
+  const uint32_t us = pmwBenchCaptureUs;
+  const uint32_t polls = pmwBenchPolls;
+  for (unsigned j=0;j<4;j++) {
+    data[9+j] = (uint8_t)(us >> (j*8));
+    data[13+j] = (uint8_t)(polls >> (j*8));
+  }
+  for (unsigned j=0;j<4;j++) {
+    data[17+2*j] = (uint8_t)pmwBenchQuarterMs[j];
+    data[18+2*j] = (uint8_t)(pmwBenchQuarterMs[j] >> 8);
+  }
+  benchSend(data,25);
+}
+
+static void benchServiceRequest(void)
+{
+  uint8_t request[30]={0};
+  const size_t len=appchannelReceiveDataPacket(request,sizeof(request),0);
+  if (len!=3||request[0]!='P'||request[1]!='X')return;
+  if (request[2]=='V') {
+    const uint8_t response[4]={'P','X','!',1};
+    benchSend(response,sizeof(response));
+  } else if (request[2]=='?') {
+    benchCameraMode=1;
+    benchSendImage();
+  }
+}
